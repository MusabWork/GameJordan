                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-item">
                            <i class="bi bi-telephone-fill"></i>
                            <div>
                                <strong>الهاتف</strong>
                                <p dir="ltr">+962 6 XXX XXXX</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="contact-item">
                            <i class="bi bi-geo-alt-fill"></i>
