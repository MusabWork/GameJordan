@{
    ViewData["Title"] = "سياسة الخصوصية";
}

<div class="privacy-page py-5">
    <div class="container">
        <!-- Header -->
        <div class="privacy-header text-center mb-5">
            <div class="privacy-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="display-4 fw-bold mb-3">سياسة الخصوصية</h1>
            <p class="lead">آخر تحديث: 20 يونيو 2026</p>
        </div>

        <!-- Introduction -->
        <div class="privacy-intro mb-5">
            <div class="intro-card">
                <p class="mb-0">
                    مرحباً بك في <strong>GameJordan</strong>. نحن نقدر خصوصيتك ونلتزم بحماية بياناتك الشخصية.
                    توضح سياسة الخصوصية هذه كيفية جمعنا واستخدامنا وحماية المعلومات التي تقدمها لنا عند استخدام موقعنا.
                </p>
            </div>
        </div>

        <!-- Privacy Sections -->
        <div class="row g-4">
            <!-- Section 1 -->
            <div class="col-md-6">
                <div class="privacy-card">
                    <div class="privacy-card-header">
                        <i class="bi bi-person-vcard-fill"></i>
                        <h3>المعلومات التي نجمعها</h3>
                    </div>
                    <div class="privacy-card-body">
                        <p>نقوم بجمع أنواع مختلفة من المعلومات لتقديم خدماتنا وتحسينها:</p>
                        <ul class="privacy-list">
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>المعلومات الشخصية:</strong>
                                    الاسم، البريد الإلكتروني، رقم الهاتف عند التسجيل
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>معلومات الاستخدام:</strong>
                                    الصفحات التي تزورها، الوقت الذي تقضيه في الموقع
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>معلومات الجهاز:</strong>
                                    نوع المتصفح، نظام التشغيل، عنوان IP
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>ملفات تعريف الارتباط:</strong>
                                    لتحسين تجربتك وتذكر تفضيلاتك
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Section 2 -->
            <div class="col-md-6">
                <div class="privacy-card">
                    <div class="privacy-card-header">
                        <i class="bi bi-gear-fill"></i>
                        <h3>كيف نستخدم معلوماتك</h3>
                    </div>
                    <div class="privacy-card-body">
                        <p>نستخدم المعلومات التي نجمعها للأغراض التالية:</p>
                        <ul class="privacy-list">
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>تقديم الخدمات:</strong>
                                    معالجة طلباتك وتوفير الدعم الفني
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>التحسين المستمر:</strong>
                                    تحليل الاستخدام لتحسين تجربة المستخدم
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>التواصل:</strong>
                                    إرسال تحديثات وعروض حصرية (بموافقتك)
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>الأمان:</strong>
                                    حماية الموقع من الاستخدام غير المصرح به
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Section 3 -->
