                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Section 6 -->
            <div class="col-md-6">
                <div class="privacy-card">
                    <div class="privacy-card-header">
                        <i class="bi bi-person-check-fill"></i>
                        <h3>حقوقك</h3>
                    </div>
                    <div class="privacy-card-body">
                        <p>لديك حقوق كاملة تجاه بياناتك الشخصية:</p>
                        <ul class="privacy-list">
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>الوصول:</strong>
                                    الحق في معرفة البيانات التي نحتفظ بها عنك
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>التصحيح:</strong>
                                    الحق في تصحيح أي معلومات غير دقيقة
                                </div>
                            </li>
                            <li>
                                <i class="bi bi-check-circle-fill"></i>
                                <div>
                                    <strong>الحذف:</strong>
                                    الحق في طلب حذف بياناتك الشخصية
                                </div>
                            </li>
                            <li>
