@model GameJordan.Models.Category

@{
    ViewData["Title"] = "حذف التصنيف";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-wrapper">
            <div class="page-icon" style="background: linear-gradient(135deg, #dc3545, #c82333);">
                <i class="bi bi-trash-fill"></i>
            </div>
            <div>
                <h1 class="page-title">حذف التصنيف</h1>
                <p class="page-subtitle">تأكيد عملية الحذف النهائي</p>
            </div>
        </div>
    </div>

    <!-- Delete Card -->
    <div class="delete-card">
        <div class="delete-header">
            <div class="delete-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2 class="delete-title">تحذير! عملية خطرة</h2>
            <p class="delete-subtitle">هل أنت متأكد من رغبتك في حذف هذا التصنيف؟</p>
        </div>

        <div class="delete-body">
            <!-- Warning Message -->
            <div class="delete-warning">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div class="delete-warning-content">
                    <h5>لا يمكن التراجع عن هذه العملية!</h5>
                    <p>
                        سيتم حذف التصنيف نهائياً من قاعدة البيانات.
                        تأكد من أنك لا تحتاج إلى هذا التصنيف قبل المتابعة.
                    </p>
                </div>
            </div>

            <!-- Item Preview -->
            <div class="delete-item-preview">
                <span class="delete-item-preview-label">التصنيف المراد حذفه</span>
                <div class="delete-item-preview-value">@Model.Name</div>
            </div>

            <!-- Details -->
            <div class="detail-row mt-3">
                <div class="detail-row-icon">
                    <i class="bi bi-hash"></i>
                </div>
                <div class="detail-row-content">
                    <span class="detail-row-label">رقم التعريف</span>
                    <span class="detail-row-value">@Model.Id</span>
                </div>
            </div>

            <div class="detail-row">
                <div class="detail-row-icon">
                    <i class="bi bi-sort-down"></i>
                </div>
                <div class="detail-row-content">
                    <span class="detail-row-label">ترتيب العرض</span>
                    <span class="detail-row-value">@Model.DisplayOrder</span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="delete-actions">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-danger-custom">
                    <i class="bi bi-trash-fill"></i>
                    نعم، احذف التصنيف
                </button>
            </form>
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-right"></i>
                إلغاء والعودة
            </a>
        </div>
    </div>
</div>