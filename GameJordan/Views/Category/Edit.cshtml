@model GameJordan.Models.Category

@{
    ViewData["Title"] = "تعديل التصنيف";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-wrapper">
            <div class="page-icon">
                <i class="bi bi-pencil-fill"></i>
            </div>
            <div>
                <h1 class="page-title">تعديل التصنيف</h1>
                <p class="page-subtitle">تعديل بيانات التصنيف المحدد</p>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Name Field -->
            <div class="form-floating">
                <input asp-for="Name" class="form-control" id="floatingName" placeholder="اسم التصنيف" />
                <label for="floatingName">
                    <i class="bi bi-tag-fill"></i>
                    اسم التصنيف
                </label>
                <span asp-validation-for="Name" class="invalid-feedback"></span>
            </div>

            <!-- DisplayOrder Field -->
            <div class="form-floating">
                <input asp-for="DisplayOrder" class="form-control" id="floatingOrder" placeholder="ترتيب العرض" type="number" min="0" />
                <label for="floatingOrder">
                    <i class="bi bi-sort-down"></i>
                    ترتيب العرض
                </label>
                <span asp-validation-for="DisplayOrder" class="invalid-feedback"></span>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <i class="bi bi-check-circle-fill"></i>
                    حفظ التغييرات
                </button>
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-right"></i>
                    إلغاء والعودة
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}